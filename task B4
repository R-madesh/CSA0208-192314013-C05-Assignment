#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct { 
    int id; 
    char group[4]; 
} Donor;

typedef struct { 
    Donor *data; 
    int size; 
    int capacity; 
} DonorList;
int add_donor(DonorList *list, int id, const char *group)
{
    if (list->size == list->capacity) {
        int new_capacity = (list->capacity == 0) ? 2 : list->capacity * 2;
        Donor *temp = (Donor *)realloc(list->data, new_capacity * sizeof(Donor));
        
        if (temp == NULL) {
            printf("Memory allocation failed!\n");
            return 0; 
        }
        list->data = temp;
        list->capacity = new_capacity;
    }
    list->data[list->size].id = id;
    strncpy(list->data[list->size].group, group, 3);
    list->data[list->size].group[3] = '\0'; 
    list->size++;
    
    return 1;
}

int main(void)
{
    DonorList list = {NULL, 0, 0};
    
    const char *groups[] = {"O+", "A+", "B-", "AB+", "O-"};

    printf("Starting Donor Registration...\n");
    printf("---------------------------------\n");

    for (int i = 0; i < 5; i++) {
        if (add_donor(&list, 7001 + i, groups[i])) {
            printf("Added %d (%s): Current Size = %d, Current Capacity = %d\n",
                   list.data[i-0].id, 
                   list.data[list.size-1].group, 
                   list.size, 
                   list.capacity);
        }
    }
    printf("\n--- Exact Expected Output Simulation ---\n");
    DonorList exact_list = {NULL, 0, 0};
    for (int i = 0; i < 5; i++) {
        add_donor(&exact_list, 7001 + i, groups[i]);
        printf("added %d (%s): size = %d, capacity = %d\n",
               exact_list.data[i].id, 
               exact_list.data[i].group, 
               exact_list.size, 
               exact_list.capacity);
    }
    free(exact_list.data);
    
    return 0;
}
