#include <stdio.h>
int main() {
    int n, i;
    unsigned long long factorial = 1;

    printf(" An integer:1 \n ");
    scanf("%d", &n);

    // Show error if the user enters a negative number
    if (n < 0) {
        printf("Error! Factorial of a negative number doesn't exist.\n");
    } else {
        for (i = 1; i <= n; ++i) {
            factorial *= i;
        }
        printf("Factorial of %d = %llu\n", n, factorial);
    }

    return 0;
}
