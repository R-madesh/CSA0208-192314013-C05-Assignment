#include <stdio.h>

int main() {
    float radius, length, width, areaCircle, areaRectangle;
    const float PI = 3.14159;

    printf("--- Area Calculator ---\n\n");

    // Task Part 1: Area of a Circle
    printf(" the radius of the circle:3.14\n ");
    scanf("%f", &radius);
    areaCircle = PI * radius * radius;
    printf("The area of the circle is: %.2f\n\n", areaCircle);

    // Task Part 2: Area of a Rectangle
    printf(" the length of the rectangle:8m\n ");
    scanf("%f", &length);
    printf(" the width of the rectangle:6m\n ");
    scanf("%f", &width);
    areaRectangle = length * width;
    printf("The area of the rectangle is: %.2f\n", areaRectangle);

    printf("\nCalculation Complete!\n");

    return 0;
}
